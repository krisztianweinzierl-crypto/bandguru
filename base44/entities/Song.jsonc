{
  "name": "Song",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Referenz zur Organisation"
    },
    "titel": {
      "type": "string",
      "description": "Song-Titel"
    },
    "kuenstler_original": {
      "type": "string",
      "description": "Original-K\u00fcnstler"
    },
    "tonart": {
      "type": "string",
      "description": "Tonart (z.B. C-Dur, Am)"
    },
    "bpm": {
      "type": "number",
      "description": "Tempo in BPM"
    },
    "laenge": {
      "type": "string",
      "description": "L\u00e4nge in MM:SS"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags f\u00fcr Kategorisierung"
    },
    "lead_sheet_url": {
      "type": "string",
      "description": "URL zum Lead Sheet"
    },
    "noten_dateien": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "description": "Hochgeladene Noten-Dateien (PDF, Bilder)"
    },
    "audio_datei": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "description": "Hochgeladene Audio-Datei (MP3)"
    },
    "audio_demo_url": {
      "type": "string",
      "description": "URL zur Audio-Demo (extern, z.B. YouTube)"
    },
    "notizen": {
      "type": "string",
      "description": "Notizen zum Song"
    }
  },
  "required": [
    "org_id",
    "titel"
  ]
}