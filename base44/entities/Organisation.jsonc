{
  "name": "Organisation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name der Organisation/Band"
    },
    "logo_url": {
      "type": "string",
      "description": "URL zum Logo"
    },
    "primary_color": {
      "type": "string",
      "description": "Prim\u00e4rfarbe in HEX",
      "default": "#3B82F6"
    },
    "adresse": {
      "type": "string",
      "description": "Vollst\u00e4ndige Adresse"
    },
    "steuernummer": {
      "type": "string",
      "description": "Steuernummer"
    },
    "ust_id": {
      "type": "string",
      "description": "Umsatzsteuer-Identifikationsnummer (USt-IdNr.)"
    },
    "inhaber": {
      "type": "string",
      "description": "Inhaber/in bzw. Gesch\u00e4ftsf\u00fchrung"
    },
    "handelsregister": {
      "type": "string",
      "description": "Registergericht und Registernummer (z.B. Amtsgericht Stuttgart, HRB 12345)"
    },
    "telefon": {
      "type": "string",
      "description": "Telefonnummer f\u00fcr Gesch\u00e4ftsdokumente"
    },
    "email": {
      "type": "string",
      "description": "E-Mail-Adresse f\u00fcr Gesch\u00e4ftsdokumente"
    },
    "website": {
      "type": "string",
      "description": "Website"
    },
    "bank_name": {
      "type": "string",
      "description": "Name der Bank"
    },
    "iban": {
      "type": "string",
      "description": "IBAN"
    },
    "bic": {
      "type": "string",
      "description": "BIC"
    },
    "waehrung": {
      "type": "string",
      "enum": [
        "EUR",
        "USD",
        "CHF",
        "GBP"
      ],
      "default": "EUR",
      "description": "Standard-W\u00e4hrung"
    },
    "zeitzone": {
      "type": "string",
      "default": "Europe/Berlin",
      "description": "Zeitzone"
    },
    "rechnungspraefix": {
      "type": "string",
      "description": "Pr\u00e4fix f\u00fcr Rechnungsnummern"
    },
    "magic_link_tage": {
      "type": "number",
      "default": 14,
      "description": "G\u00fcltigkeit Magic-Links in Tagen"
    }
  },
  "required": [
    "name"
  ]
}